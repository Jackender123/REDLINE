
# ==========================================
# REDLINE - GIT IGNORE
# ==========================================

# Local tools and downloaded dependencies
/tools/local/
/tools/node_modules/

# ==========================================
# USER UPLOADS
# ==========================================

# Ignore runtime uploads
/www/uploads/**/*

# Keep directories and access rules
!/www/uploads/**/
!/www/uploads/**/.htaccess

# Keep required files
!/www/uploads/work-orders/index.html

# Keep selected images
!/www/uploads/reception/d36453c8e139233738f027f5bdc00f5a.png
!/www/uploads/requests/e51848359ef9b97d.jpg
!/www/uploads/vehicles/63fcd76f0999962c0c54.jpg
!/www/uploads/vehicles/672968a6d94b8f813de2.jpg
!/www/uploads/vehicles/78b2b21c409eb6775a03.jpg
!/www/uploads/vehicles/838a91ee542019185b2d.webp
!/www/uploads/vehicles/8e96c5acbedefbfacc0c.jpg
!/www/uploads/vehicles/acdae37180daf96dfcb4.jpg

# ==========================================
# RUNTIME AND COMPOSER
# ==========================================

/www/logs/
/www/vendor/

# ==========================================
# STRIPE PRIVATE CONFIGURATION
# ==========================================

# Never commit real Stripe credentials
**/redline-stripe.private.php

# Environment files
**/.env
**/.env.*

# Allow example environment files
!**/.env.example

# IMPORTANT:
# deployment/redline-stripe.private.example.php
# is tracked as an example configuration.
# Never put actual Stripe API keys inside it.
# Stripe - never upload to GitHub
/deployment/redline-stripe.private.example.php
/deployment/redline-stripe.private.php
/redline-stripe.private.php